SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=DO_NOT_COMMIT
DASHBOARD_USER=gn
DASHBOARD_PASSWORD=DO_NOT_COMMIT

# GN multi-AI analysis is read-only and disabled by default for local runs.
AI_ANALYSIS_ENABLED=false
AI_MAX_COST_USD_PER_RUN=0.05
AI_MAX_INPUT_CHARS=12000

PERPLEXITY_ENABLED=false
PERPLEXITY_API_KEY=DO_NOT_COMMIT
PERPLEXITY_TIMEOUT_MS=15000
PERPLEXITY_MAX_OUTPUT_TOKENS=256
PERPLEXITY_MAX_COST_USD=0.02

XAI_ENABLED=false
XAI_API_KEY=DO_NOT_COMMIT
XAI_TIMEOUT_MS=15000
XAI_MAX_OUTPUT_TOKENS=256
XAI_MAX_COST_USD=0.02

DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=DO_NOT_COMMIT
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_MAX_OUTPUT_TOKENS=256
DEEPSEEK_MAX_COST_USD=0.02

ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=DO_NOT_COMMIT
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TIMEOUT_MS=15000
ANTHROPIC_MAX_OUTPUT_TOKENS=256
ANTHROPIC_MAX_COST_USD=0.02

GEMINI_ENABLED=false
GEMINI_API_KEY=DO_NOT_COMMIT
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_OUTPUT_TOKENS=256
GEMINI_MAX_COST_USD=0.02
